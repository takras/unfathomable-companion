# Copy to android/keystore.properties (git-ignored) to sign release builds locally.
# On CI the same values come from environment variables instead:
# UNF_KEYSTORE_FILE, UNF_KEYSTORE_PASSWORD, UNF_KEY_ALIAS, UNF_KEY_PASSWORD.
storeFile=../upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
