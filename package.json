{
  "name": "unfathomable-companion",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "portraits": "python -I scripts/extract_portraits.py",
    "icons": "node scripts/icon.mjs && capacitor-assets generate --ios --android --iconBackgroundColor \"#141a36\" --iconBackgroundColorDark \"#141a36\" --splashBackgroundColor \"#141a36\" --splashBackgroundColorDark \"#141a36\"",
    "rules": "python -I scripts/extract_rules.py",
    "preludes": "python -I scripts/extract_preludes.py",
    "app-icon": "node scripts/icon.mjs",
    "cap:sync": "npm run build && cap sync",
    "android": "npm run cap:sync && cap open android",
    "ios": "npm run cap:sync && cap open ios",
    "android:debug": "npm run cap:sync && node scripts/gradle.mjs assembleDebug",
    "android:release": "npm run cap:sync && node scripts/gradle.mjs bundleRelease",
    "android:install": "npm run cap:sync && node scripts/gradle.mjs installDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@fontsource/eb-garamond": "5.3.0",
    "@fontsource/federant": "5.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "sharp": "0.34.5",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
